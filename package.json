{
  "name": "bridge",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:companion": "npm run dev --workspace @bridge/companion",
    "dev:figma": "npm run dev --workspace @bridge/figma-plugin",
    "dev:ai": "npm run dev --workspace @bridge/ai-plugin",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.125.0",
    "@types/node": "^20.19.39",
    "typescript": "^5.4.0"
  }
}
