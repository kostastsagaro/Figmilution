{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@bridge/shared": ["packages/shared/dist/index.d.ts"],
      "@bridge/shared/*": ["packages/shared/dist/*"]
    }
  }
}
