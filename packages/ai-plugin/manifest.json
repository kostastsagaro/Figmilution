{
  "id": "com.bridge.ai-plugin",
  "name": "Bridge",
  "version": "0.6.0",
  "manifestVersion": 5,
  "host": [
    {
      "app": "ILST",
      "minVersion": "26.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridge.panel",
      "label": { "default": "Bridge" },
      "main": "panel.html",
      "minimumSize": { "width": 240, "height": 200 },
      "preferredDockedSize": { "width": 280, "height": 320 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["ws://127.0.0.1:7711", "http://127.0.0.1:7711"]
    }
  }
}
